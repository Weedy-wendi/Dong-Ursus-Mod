+/** First seed ≥ `from` whose match pool offers chess of every bond up to `maxTier`. */
+function seedWithBonds(bonds, maxTier, from = 40) {
+  for (let s = from; s < from + 200; s++) {
+    const h = makeMatch({ mode: 'solo', seed: s, registry: REG, fake: true });
+    if (bonds.every((b) => bondPool(h.m, b, maxTier).length > 0)) return s;
+  }
+  throw new Error(`no seed with ${bonds.join(' + ')} ≤ tier ${maxTier}`);
+}
+const clearHands = (ps) => { ps.hand.fill(null); ps.temp.fill(null); };
+const battleOver = (m, ps, lpLoss) => m.dispatch(ps, 'onBattleResult', { lpLoss, perfect: lpLoss === 0, result: {}, unite: null });
+
+test('天尊救我 泰拉大陆调查团: losing LP ⇒ next round start 1 operator — tier = shop level + 1, bond = the active bond with the most layers (ties: earlier in the table)', () => {
+  // a seed whose pool holds a tier-3 东 operator (the tie case asserts the exact tier: shop level 2 + 1)
+  let seed = seedWithBonds(['dongShip', 'ursusShip'], 3);
+  for (let s = seed; s < seed + 200; s++) {
+    const h = makeMatch({ mode: 'solo', seed: s, registry: REG, fake: true });
+    if (bondPool(h.m, 'dongShip', 3).some((id) => DATA.chess[id].tier === 3)) { seed = s; break; }
+  }
+  const { m, ps, roundStart } = setup({ band: 'band_palico', seed });
+  ps.shop.level = 2;
+  // no LP lost: nothing
+  clearHands(ps);
+  battleOver(m, ps, 0);
+  roundStart(3);
+  assert.equal(handIds(ps, 'chess').length, 0, 'no loss, no operator');
+  // 乌萨斯 with more layers than 东 ⇒ an 乌萨斯 operator (its own tier is whatever the pool has)
+  ps.bonds = { dongShip: { active: true, count: 3 }, ursusShip: { active: true, count: 3 } };
+  ps.layers = { dongShip: 6, ursusShip: 9 };
+  clearHands(ps);
+  battleOver(m, ps, 1);
+  roundStart(4);
+  let got = handIds(ps, 'chess');
+  assert.equal(got.length, 1, 'exactly 1 operator, however many LP were lost');
+  assert.ok(DATA.chess[got[0]].bonds.includes('ursusShip'));
+  // equal layers ⇒ the earlier bond of the table (东, identifier 900 < 901); shop level 2 ⇒ tier 3
+  // (a grant recomputes the bonds from the empty board ⇒ stub them again for every case)
+  ps.bonds = { dongShip: { active: true, count: 3 }, ursusShip: { active: true, count: 3 } };
+  ps.layers = { dongShip: 6, ursusShip: 6 };
+  clearHands(ps);
+  battleOver(m, ps, 4);
+  roundStart(5);
+  got = handIds(ps, 'chess');
+  assert.equal(got.length, 1);
+  assert.ok(DATA.chess[got[0]].bonds.includes('dongShip'));
+  assert.equal(DATA.chess[got[0]].tier, 3, 'shop level 2 + 1');
+  // nothing active ⇒ a random operator of that tier
+  ps.bonds = {};
+  ps.layers = {};
+  clearHands(ps);
+  battleOver(m, ps, 1);
+  roundStart(6);
+  got = handIds(ps, 'chess');
+  assert.equal(got.length, 1);
+  assert.equal(DATA.chess[got[0]].tier, 3);
+  cover('band_palico');
+});
